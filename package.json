{
  "name": "@local/token-vault",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Local token vault: store Git and other API tokens, use them from any session through placeholders without the value entering the session.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ming-a1/token-vault.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "token",
    "secret",
    "git"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
